{
  "name": "file-renamer",
  "productName": "Batch File Renamer",
  "version": "0.1.0",
  "description": "Rename many files at once with rules you can see before anything changes, and undo any batch. Offline.",
  "main": "src/main.js",
  "license": "MIT",
  "author": {
    "name": "xotwodfr",
    "email": "xotwodfr@users.noreply.github.com"
  },
  "homepage": "https://github.com/xotwodfr/toolslauncher",
  "scripts": {
    "start": "node ../../node_modules/electron/cli.js .",
    "test": "node test/renamer.test.js",
    "e2e": "node test/run-e2e.js",
    "dist:win": "node ../../node_modules/electron-builder/cli.js --win zip --publish never",
    "dist:linux": "node ../../node_modules/electron-builder/cli.js --linux zip --publish never"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "music-metadata": "^11.16.1"
  },
  "build": {
    "appId": "com.toolslauncher.filerenamer",
    "productName": "Batch File Renamer",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "artifactName": "BatchFileRenamer-${version}-${os}-${arch}.${ext}",
    "executableName": "file-renamer",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility"
    }
  }
}
