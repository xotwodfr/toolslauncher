{
  "name": "audio-inspector",
  "productName": "Audio Inspector",
  "version": "0.1.0",
  "description": "See what is really inside your audio files: catches fake lossless (FLAC/WAV made from MP3), upsampled and fake 24-bit files, and measures loudness, peaks and clipping. Offline.",
  "main": "src/main.js",
  "license": "MIT",
  "author": { "name": "xotwodfr", "email": "xotwodfr@users.noreply.github.com" },
  "homepage": "https://github.com/xotwodfr/toolslauncher",
  "scripts": {
    "setup": "node scripts/fetch-ffmpeg.js",
    "start": "node ../../node_modules/electron/cli.js .",
    "test": "node test/inspector.test.js",
    "e2e": "node test/run-e2e.js",
    "dist:win": "node scripts/fetch-ffmpeg.js && node ../../node_modules/electron-builder/cli.js --win zip --publish never",
    "dist:linux": "node scripts/fetch-ffmpeg.js && node ../../node_modules/electron-builder/cli.js --linux zip --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.toolslauncher.audioinspector",
    "productName": "Audio Inspector",
    "electronVersion": "33.4.11",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "artifactName": "AudioInspector-${version}-${os}-${arch}.${ext}",
    "executableName": "audio-inspector",
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "linux": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  }
}
