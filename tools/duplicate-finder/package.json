{
  "name": "duplicate-finder",
  "productName": "Duplicate Finder",
  "version": "0.1.1",
  "description": "Find duplicate files, look-alike photos and repeated songs, review them, and move the extras to the Recycle Bin. Nothing is deleted for good.",
  "main": "src/main.js",
  "license": "MIT",
  "author": { "name": "xotwodfr", "email": "xotwodfr@users.noreply.github.com" },
  "homepage": "https://github.com/xotwodfr/toolslauncher",
  "scripts": {
    "setup": "node scripts/fetch-ffmpeg.js",
    "start": "node ../../node_modules/electron/cli.js .",
    "test": "node test/dupes.test.js",
    "e2e": "node test/run-e2e.js",
    "dist:win": "node scripts/fetch-ffmpeg.js && node ../../node_modules/electron-builder/cli.js --win zip --publish never",
    "dist:linux": "node scripts/fetch-ffmpeg.js && node ../../node_modules/electron-builder/cli.js --linux zip --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "node-taglib-sharp": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "com.toolslauncher.duplicatefinder",
    "productName": "Duplicate Finder",
    "electronVersion": "33.4.11",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "artifactName": "DuplicateFinder-${version}-${os}-${arch}.${ext}",
    "executableName": "duplicate-finder",
    "win": { "target": [{ "target": "zip", "arch": ["x64"] }], "icon": "build/icon.png", "signExecutable": false },
    "linux": { "target": [{ "target": "zip", "arch": ["x64"] }], "icon": "build/icon.png", "category": "Utility" }
  }
}
