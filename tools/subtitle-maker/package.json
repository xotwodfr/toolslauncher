{
  "name": "subtitle-maker",
  "productName": "Subtitle Maker",
  "version": "0.1.0",
  "description": "Write subtitles for a video or audio file from its speech, offline (Whisper). Edit them, save .srt/.vtt, or burn them into the video.",
  "main": "src/main.js",
  "license": "MIT",
  "author": { "name": "xotwodfr", "email": "xotwodfr@users.noreply.github.com" },
  "homepage": "https://github.com/xotwodfr/toolslauncher",
  "scripts": {
    "setup": "node scripts/fetch-ffmpeg.js && node scripts/fetch-model.js",
    "start": "node ../../node_modules/electron/cli.js .",
    "test": "node test/subtitles.test.js",
    "e2e": "node test/run-e2e.js",
    "dist:win": "node scripts/fetch-ffmpeg.js && node scripts/fetch-model.js && node ../../node_modules/electron-builder/cli.js --win zip --publish never",
    "dist:linux": "node scripts/fetch-ffmpeg.js && node scripts/fetch-model.js && node ../../node_modules/electron-builder/cli.js --linux zip --publish never"
  },
  "dependencies": {
    "dejavu-fonts-ttf": "^2.37.3",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.22.0"
  },
  "build": {
    "appId": "com.toolslauncher.subtitlemaker",
    "productName": "Subtitle Maker",
    "electronVersion": "33.4.11",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "models/*", "package.json", "!node_modules/dejavu-fonts-ttf/ttf/DejaVuSerif*", "!node_modules/dejavu-fonts-ttf/ttf/DejaVuSansMono*", "!node_modules/dejavu-fonts-ttf/ttf/DejaVuSansCondensed*", "!node_modules/dejavu-fonts-ttf/ttf/DejaVuMathTeXGyre.ttf", "!node_modules/dejavu-fonts-ttf/ttf/DejaVuSans-ExtraLight.ttf", "!node_modules/dejavu-fonts-ttf/ttf/DejaVuSans-Oblique.ttf", "!node_modules/dejavu-fonts-ttf/ttf/DejaVuSans-BoldOblique.ttf", "!node_modules/dejavu-fonts-ttf/fontconfig/**"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/onnxruntime-node/**", "models/**"],
    "artifactName": "SubtitleMaker-${version}-${os}-${arch}.${ext}",
    "executableName": "subtitle-maker",
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "signExecutable": false,
      "files": ["!node_modules/onnxruntime-node/bin/napi-v6/darwin/**", "!node_modules/onnxruntime-node/bin/napi-v6/linux/**", "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"]
    },
    "linux": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "files": ["!node_modules/onnxruntime-node/bin/napi-v6/darwin/**", "!node_modules/onnxruntime-node/bin/napi-v6/win32/**", "!node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**", "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_cuda.so", "!node_modules/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_tensorrt.so"]
    }
  }
}
