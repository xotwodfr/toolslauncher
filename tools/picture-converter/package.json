{
  "name": "picture-converter",
  "productName": "Picture Converter",
  "version": "0.2.0",
  "description": "Batch convert and resize images between 14 formats (JPEG, PNG, WebP, GIF, AVIF, JPEG XL, TIFF, PDF, BMP, ICO, TGA, QOI, PPM, PGM).",
  "main": "src/main.js",
  "license": "MIT",
  "author": {
    "name": "xotwodfr",
    "email": "xotwodfr@users.noreply.github.com"
  },
  "homepage": "https://github.com/xotwodfr/toolslauncher",
  "scripts": {
    "start": "node ../../node_modules/electron/cli.js .",
    "test": "node test/convert.test.js && node test/codecs.test.js && node test/formats.test.js",
    "dist:win": "node ../../node_modules/electron-builder/cli.js --win zip --publish never",
    "dist:linux": "node ../../node_modules/electron-builder/cli.js --linux zip --publish never"
  },
  "dependencies": {
    "@jsquash/jxl": "^1.3.0",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.toolslauncher.pictureconverter",
    "productName": "Picture Converter",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/@jsquash/**",
      "node_modules/wasm-feature-detect/**"
    ],
    "artifactName": "PictureConverter-${version}-${os}-${arch}.${ext}",
    "executableName": "picture-converter",
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "linux": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Graphics"
    }
  }
}
